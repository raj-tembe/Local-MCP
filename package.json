{
  "name": "local-mcp",
  "version": "0.2.3",
  "description": "Secure local terminal bridge for cloud-based AI via MCP",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/raj-tembe/Local-MCP.git"
  },
  "bugs": {
    "url": "https://github.com/raj-tembe/Local-MCP/issues"
  },
  "homepage": "https://github.com/raj-tembe/Local-MCP#readme",
  "type": "module",
  "bin": {
    "local-mcp": "dist/cli.js"
  },
  "files": [
    "dist",
    "!dist/**/*.test.*",
    "README.md",
    "SECURITY.md",
    "LICENSE",
    "docs",
    "examples"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx src/cli.ts",
    "start": "node dist/cli.js",
    "test": "vitest run",
    "lint": "eslint . --ext .ts",
    "prepublishOnly": "npm run build && npm test",
    "build:binary": "node scripts/build-binary.mjs",
    "smoke:binary": "node scripts/smoke-binary.mjs",
    "version": "node scripts/sync-version.mjs && git add src/version.ts"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "packageManager": "pnpm@9.0.0",
  "keywords": [
    "mcp",
    "local-ai",
    "terminal",
    "security",
    "claude",
    "ai"
  ],
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "@types/glob": "^8.1.0",
    "commander": "^12.1.0",
    "express": "^5.2.1",
    "glob": "^13.0.6",
    "ws": "^8.0.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.2",
    "@types/node": "^22.7.4",
    "@types/supertest": "^7.2.1",
    "@types/ws": "^8.0.0",
    "esbuild": "^0.28.2",
    "postject": "1.0.0-alpha.6",
    "supertest": "^7.2.2",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vitest": "^2.1.5"
  },
  "optionalDependencies": {
    "node-pty": "^1.0.0"
  }
}
