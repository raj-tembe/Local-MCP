{
  "name": "local-mcp",
  "version": "0.1.0",
  "description": "Secure local terminal bridge for cloud-based AI via MCP",
  "type": "module",
  "bin": {
    "local-mcp": "dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "SECURITY.md",
    "docs",
    "examples"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx src/cli.ts",
    "start": "node dist/cli.js",
    "test": "vitest run",
    "lint": "eslint . --ext .ts"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "packageManager": "pnpm@9.0.0",
  "keywords": [
    "mcp",
    "local-ai",
    "terminal",
    "security",
    "claude",
    "ai"
  ],
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.0",
    "@types/cors": "^2.8.19",
    "commander": "^12.1.0",
    "cors": "^2.8.6",
    "dotenv": "^16.4.1",
    "jsonwebtoken": "^9.0.2",
    "localtunnel": "^2.0.2",
    "node-pty": "^1.0.0",
    "pino": "^9.0.0",
    "ws": "^8.0.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.2",
    "@types/node": "^22.7.4",
    "@types/supertest": "^7.2.1",
    "@types/ws": "^8.0.0",
    "supertest": "^7.2.2",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vitest": "^2.1.5"
  }
}
